{
  "name": "voice-agent",
  "private": true,
  "description": "Telugu voice agent monorepo — run scripts from repo root only",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev_stack.ps1 -KillStale -Mode auto",
    "dev:open": "powershell -ExecutionPolicy Bypass -File scripts/dev_stack.ps1 -KillStale -Mode auto -Open",
    "start": "npm run dev",
    "dev:down": "powershell -ExecutionPolicy Bypass -File scripts/dev_down.ps1",
    "dev:up": "powershell -ExecutionPolicy Bypass -File scripts/dev_up.ps1 -KillStale -Wait",
    "dev:api": "python -m uvicorn server.app:app --host 127.0.0.1 --port 8000 --reload --reload-dir server",
    "dev:web": "npm run dev --prefix web -- -p 3000",
    "dev:voxly": "npm run dev --prefix voxly-ai",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev_stack.ps1 -KillStale -Mode local",
    "dev:full": "powershell -ExecutionPolicy Bypass -File scripts/dev_stack.ps1 -KillStale -Mode telephony",
    "dev:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/tunnel_cloudflared.ps1",
    "dev:cf-setup": "powershell -ExecutionPolicy Bypass -File scripts/setup_cloudflare_tunnel.ps1",
    "dev:cf-tunnel": "powershell -ExecutionPolicy Bypass -File scripts/run_cloudflare_tunnel.ps1",
    "share": "powershell -ExecutionPolicy Bypass -File scripts/dev_stack.ps1 -KillStale -Mode share",
    "share:ngrok": "powershell -ExecutionPolicy Bypass -File scripts/share_with_friend.ps1 -Tunnel ngrok",
    "share:cf": "powershell -ExecutionPolicy Bypass -File scripts/share_with_friend.ps1 -Tunnel cloudflared"
  }
}
