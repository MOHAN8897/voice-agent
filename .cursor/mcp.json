{
  "mcpServers": {
    "composio": {
      "type": "http",
      "url": "https://connect.composio.dev/mcp"
    },
    "graft": {
      "command": "graft",
      "args": ["mcp"]
    },
    "google-cloud-cli": {
      "url": "https://cloudcli.googleapis.com/mcp"
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"]
    }
  }
}
