# Telugu Voice Agent — Environment Template
# Copy to .env and fill. Never commit .env
# Docs: https://platform.openai.com/docs/models and https://docs.sarvam.ai

OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
OPENAI_MODEL=gpt-5.6-luna
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_TE=shubh
SARVAM_TTS_PACE=1.08
MAX_RESPONSE_LENGTH=320
MAX_CONTEXT_MESSAGES=4
BRAIN_PROMPT_BUDGET_TOKENS=1500
BRAIN_PROMPT_BUDGET_MIN=1500
BRAIN_PROMPT_BUDGET_MAX=5000
ENABLE_PROMPT_CACHING=true
PROMPT_CACHE_TTL=30m
PROMPT_CACHE_KEY_PREFIX=telugu-voice:v5
PROMPT_CACHE_MIN_TOKENS=1024
ENABLE_SESSION_SUMMARY=false
SUMMARY_EVERY_N_TURNS=4
BRAIN_CONTEXT_TURNS=2
MAX_HISTORY_ASSISTANT_CHARS=120
MAX_HISTORY_USER_CHARS=300
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=2
LOG_LEVEL=info
LOG_ENABLED=true
LOG_VOICE=true
LOG_STT=true
LOG_BRAIN=true
LOG_TTS=true
LOG_WS=true
LOG_PERF=true
LOG_CLIENT=true
VOICE_HTTP_TTS_FALLBACK=false
SARVAM_TTS_TEMPERATURE=0.4
DEBUG=false
PORT=8000
CLIENT_URL=http://localhost:8000

# Fine-tune console: allowlist of models users may pick in the UI (comma-separated)
OPENAI_ALLOWED_MODELS=gpt-5.5,gpt-5.4,gpt-5,gpt-5.6-luna