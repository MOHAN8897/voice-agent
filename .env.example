# Telugu Voice Agent — Environment Template
# Copy to .env and fill. Never commit .env
# Docs: https://platform.openai.com/docs/models and https://docs.sarvam.ai

OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
OPENAI_MODEL=gpt-5.6-luna
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_TE=shubh
SARVAM_TTS_PACE=1.08
MAX_RESPONSE_LENGTH=320
MAX_CONTEXT_MESSAGES=4
BRAIN_PROMPT_BUDGET_TOKENS=3500
BRAIN_PROMPT_BUDGET_MIN=1500
BRAIN_PROMPT_BUDGET_MAX=5000
ENABLE_PROMPT_CACHING=true
PROMPT_CACHE_TTL=30m
PROMPT_CACHE_KEY_PREFIX=telugu-voice:v5
PROMPT_CACHE_MIN_TOKENS=1024
ENABLE_SESSION_SUMMARY=false
ENABLE_WORKING_MEMORY=true
WORKING_MEMORY_MAX_CHARS=2000
MEMORY_PROJECTION_MAX_TOKENS=150
ROLLING_SUMMARY_MAX_TOKENS=150
ROLLING_SUMMARY_INTERVAL_TURNS=5
ENABLE_MEMORY_EXTRACTION_FALLBACK=false
POST_CALL_LLM_MODEL=gpt-5.6-luna
SUMMARY_EVERY_N_TURNS=4
BRAIN_CONTEXT_TURNS=2
MAX_HISTORY_ASSISTANT_CHARS=120
MAX_HISTORY_USER_CHARS=300
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=2
LOG_LEVEL=info
LOG_ENABLED=true
LOG_VOICE=true
LOG_STT=true
LOG_BRAIN=true
LOG_TTS=true
LOG_WS=true
LOG_PERF=true
LOG_CLIENT=true
LOG_PSTN=true
VOICE_HTTP_TTS_FALLBACK=false
SARVAM_TTS_TEMPERATURE=0.4
DEBUG=false
PORT=8000
CLIENT_URL=http://localhost:3000

# --- Public URLs (auto-synced by npm run dev / scripts/env_sync.ps1) ---
# Named Cloudflare tunnel (production-like dev):
# PUBLIC_TUNNEL_URL=https://api-dev.yourdomain.com
# EXOTEL_WEBHOOK_BASE_URL=https://api-dev.yourdomain.com
# PUBLIC_APP_URL=https://app-dev.yourdomain.com
# CLIENT_URL=https://app-dev.yourdomain.com
# Local only: leave PUBLIC_TUNNEL_URL unset; CLIENT_URL=http://localhost:3000

# Fine-tune console: allowlist of models users may pick in the UI (comma-separated)
OPENAI_ALLOWED_MODELS=gpt-5.5,gpt-5.4,gpt-5,gpt-5.6-luna

# --- Phase 1: Provider platform ---
VOICE_AGENT_CONFIG_MODE=frontend
VOICE_AGENT_TIER=medium
APP_ENVIRONMENT=development
ENABLE_SARVAM=true
ENABLE_OPENAI=true
ENABLE_DEEPSEEK=false
ENABLE_GEMINI=false
ENABLE_CARTESIA=false
USE_PROVIDER_REGISTRY=true
USE_VERSIONED_BRAINS=false
ALLOW_PUBLISH_DURING_CALLS=false
ENABLE_BENCHMARKS=false
FX_RATE_INR=95.64

# --- PostgreSQL (required for full dev: calls, brains, tier cache) ---
# Windows (PostgreSQL 18 service): run once:
#   powershell -ExecutionPolicy Bypass -File scripts/setup_postgres_dev.ps1
# Or: python scripts/setup_postgres_dev.py --admin-password YOUR_POSTGRES_PASSWORD
# Docker (when Docker Desktop installed):
#   docker compose up -d postgres && python scripts/migrate_db.py
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent
# POSTGRES_ADMIN_PASSWORD=your_postgres_superuser_password

# --- Phase 3: Call lifecycle ---
CALL_AUTO_END_ON_START=true
CALL_RETENTION_DAYS=90
DATA_DIR=data
ENABLE_CALL_ARCHIVE=true
CALL_IDLE_TIMEOUT_SEC=300
DEEPSEEK_BASE_URL=https://api.deepseek.com
CALL_STALE_HEARTBEAT_SEC=120

# LOW tier bundle
VOICE_LOW_STT_PROVIDER=sarvam
VOICE_LOW_STT_MODEL=saaras:v3
VOICE_LOW_LLM_PROVIDER=openai
VOICE_LOW_LLM_MODEL=gpt-5.6-luna
VOICE_LOW_TTS_PROVIDER=sarvam
VOICE_LOW_TTS_MODEL=bulbul:v3

# MEDIUM tier bundle
VOICE_MEDIUM_STT_PROVIDER=sarvam
VOICE_MEDIUM_STT_MODEL=saaras:v3-realtime
VOICE_MEDIUM_LLM_PROVIDER=openai
VOICE_MEDIUM_LLM_MODEL=gpt-5.6-luna
VOICE_MEDIUM_TTS_PROVIDER=sarvam
VOICE_MEDIUM_TTS_MODEL=bulbul:v3

# PREMIUM tier bundle (Cartesia optional — enable ENABLE_CARTESIA after benchmark)
VOICE_PREMIUM_STT_PROVIDER=sarvam
VOICE_PREMIUM_STT_MODEL=saaras:v3-realtime
VOICE_PREMIUM_LLM_PROVIDER=openai
VOICE_PREMIUM_LLM_MODEL=gpt-5.6-luna
VOICE_PREMIUM_TTS_PROVIDER=sarvam
VOICE_PREMIUM_TTS_MODEL=bulbul:v3

# --- Phase 5: Production platform ---
SESSION_SECRET=change-me-in-production
DEV_PORTAL_USERNAME=dev
DEV_PORTAL_PASSWORD=change-me
# Optional: pbkdf2-sha256 hash instead of plain text (python -c "from server.auth.passwords import hash_portal_password; print(hash_portal_password('your-password'))")
# APP_CONSOLE_USERNAME=
# APP_CONSOLE_PASSWORD=
# E2E defaults (Playwright): e2e / e2e-test
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
SERVE_CLIENT_STATIC=true
# REDIS_URL=redis://localhost:6379/0
ENABLE_EXOTEL=true
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_ACCOUNT_SID=          # From Exotel dashboard → API Settings
EXOTEL_SUBDOMAIN=api.exotel.com
# EXOTEL_EXOPHONE=+91XXXXXXXXXX
# EXOTEL_WEBHOOK_BASE_URL=https://your-tunnel.example.com

# Active PSTN provider for dev Test Studio (exotel | telnyx | plivo)
# Telnyx L16 @ 16 kHz is the validated production path (tests 1–10).
TELEPHONY_PROVIDER=telnyx
ENABLE_TELNYX=true
# TELNYX_API_KEY=              # Telnyx Mission Control → API Keys
# TELNYX_CONNECTION_ID=        # Call Control Application connection ID
# TELNYX_PHONE_NUMBER=+91XXXXXXXXXX
# TELNYX_OUTBOUND_VOICE_PROFILE_ID=   # optional — auto-discovered from Default OVP
ENABLE_PLIVO=false
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_PHONE_NUMBER=+91XXXXXXXXXX
CAMPAIGN_MAX_CONCURRENCY=5
RECORDING_CONSENT_REQUIRED=false

# --- Production canary (TEST 9) ---
# CANARY_ENABLED=false
# CANARY_MAX_CALLS_PER_DAY=20
# CANARY_ALLOWED_DESTINATIONS=+918897908470,+13526146416
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Next.js web (web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000