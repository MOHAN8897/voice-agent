# Telugu Voice Agent — Environment Template
# Copy to .env and fill. Never commit .env
# Docs: https://platform.openai.com/docs/models and https://docs.sarvam.ai

OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
OPENAI_MODEL=gpt-realtime-2.1-mini
OPENAI_TEMPERATURE=0.625
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_TE=shubh
# Sarvam Bulbul: pace 1.0 = natural phone speed; temperature ~0.7 for natural prosody
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.70
MAX_RESPONSE_LENGTH=320
MAX_CONTEXT_MESSAGES=4
BRAIN_PROMPT_BUDGET_TOKENS=3500
BRAIN_PROMPT_BUDGET_MIN=1500
BRAIN_PROMPT_BUDGET_MAX=5000
ENABLE_PROMPT_CACHING=true
PROMPT_CACHE_TTL=30m
PROMPT_CACHE_KEY_PREFIX=telugu-voice:v5
PROMPT_CACHE_MIN_TOKENS=1024
ENABLE_SESSION_SUMMARY=false
ENABLE_WORKING_MEMORY=true
WORKING_MEMORY_MAX_CHARS=2000
MEMORY_PROJECTION_MAX_TOKENS=150
ROLLING_SUMMARY_MAX_TOKENS=150
ROLLING_SUMMARY_INTERVAL_TURNS=5
ENABLE_MEMORY_EXTRACTION_FALLBACK=false
POST_CALL_LLM_MODEL=gpt-5.6-luna
VOICE_PIPELINE_MODE=realtime_text
SUMMARY_EVERY_N_TURNS=4
BRAIN_CONTEXT_TURNS=2
MAX_HISTORY_ASSISTANT_CHARS=120
MAX_HISTORY_USER_CHARS=300
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=2
LOG_LEVEL=info
LOG_ENABLED=true
LOG_VOICE=true
LOG_STT=true
LOG_BRAIN=true
LOG_TTS=true
LOG_WS=true
LOG_PERF=true
LOG_CLIENT=true
LOG_PSTN=true
VOICE_HTTP_TTS_FALLBACK=false
DEBUG=false
PORT=8000
CLIENT_URL=http://localhost:3000

# --- Public URLs (auto-synced by npm run dev / scripts/env_sync.ps1) ---
# Named Cloudflare tunnel (production-like dev):
# PUBLIC_TUNNEL_URL=https://api-dev.yourdomain.com
# EXOTEL_WEBHOOK_BASE_URL=https://api-dev.yourdomain.com
# PUBLIC_APP_URL=https://app-dev.yourdomain.com
# CLIENT_URL=https://app-dev.yourdomain.com
# Local only: leave PUBLIC_TUNNEL_URL unset; CLIENT_URL=http://localhost:3000

# Fine-tune console: allowlist of models users may pick in the UI (comma-separated)
OPENAI_ALLOWED_MODELS=gpt-realtime-2.1-mini,gpt-realtime-2.1,gpt-realtime-2,gpt-5.5,gpt-5.4,gpt-5,gpt-5.6-luna

# --- Phase 1: Provider platform ---
VOICE_AGENT_CONFIG_MODE=frontend
VOICE_AGENT_TIER=medium
APP_ENVIRONMENT=development
ENABLE_SARVAM=true
ENABLE_OPENAI=true
ENABLE_DEEPSEEK=false
# Gemini is not part of the LLM stack. Live LLM is OpenAI Realtime text-only.
ENABLE_GEMINI=false
ENABLE_CARTESIA=false
# Cartesia Sonic delivery (not an LLM prompt) — generation_config
# CARTESIA_TTS_MODEL=sonic-3.5
# CARTESIA_TTS_VOICE_ID=
# CARTESIA_TTS_EMOTION=calm
# CARTESIA_TTS_SPEED=1.0
# CARTESIA_TTS_VOLUME=1.0
USE_PROVIDER_REGISTRY=true
USE_VERSIONED_BRAINS=false
ALLOW_PUBLISH_DURING_CALLS=false
ENABLE_BENCHMARKS=false
FX_RATE_INR=95.64
# Live USD→INR via Frankfurter (cached 6h). Fallback to FX_RATE_INR. INR is conversion only (no GST).
FX_RATE_LIVE=true
FX_RATE_LIVE_TTL_SEC=21600

# --- PostgreSQL (required for full dev: calls, brains, tier cache) ---
# Windows (PostgreSQL 18 service): run once:
#   powershell -ExecutionPolicy Bypass -File scripts/setup_postgres_dev.ps1
# Or: python scripts/setup_postgres_dev.py --admin-password YOUR_POSTGRES_PASSWORD
# Docker (when Docker Desktop installed):
#   docker compose up -d postgres && python scripts/migrate_db.py
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent
# POSTGRES_ADMIN_PASSWORD=your_postgres_superuser_password

# Database pool tuning (Phase 1 scalability)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=20.0
DB_POOL_RECYCLE=1800

# --- Phase 3: Call lifecycle ---
CALL_AUTO_END_ON_START=true
CALL_RETENTION_DAYS=90
DATA_DIR=data
ENABLE_CALL_ARCHIVE=true
CALL_IDLE_TIMEOUT_SEC=300
DEEPSEEK_BASE_URL=https://api.deepseek.com
CALL_STALE_HEARTBEAT_SEC=120

# LOW tier bundle
VOICE_LOW_STT_PROVIDER=sarvam
VOICE_LOW_STT_MODEL=saaras:v3
VOICE_LOW_LLM_PROVIDER=openai
VOICE_LOW_LLM_MODEL=gpt-realtime-2.1-mini
VOICE_LOW_TTS_PROVIDER=sarvam
VOICE_LOW_TTS_MODEL=bulbul:v3

# MEDIUM tier bundle
VOICE_MEDIUM_STT_PROVIDER=sarvam
VOICE_MEDIUM_STT_MODEL=saaras:v3-realtime
VOICE_MEDIUM_LLM_PROVIDER=openai
VOICE_MEDIUM_LLM_MODEL=gpt-realtime-2.1-mini
VOICE_MEDIUM_TTS_PROVIDER=sarvam
VOICE_MEDIUM_TTS_MODEL=bulbul:v3

# PREMIUM tier bundle (Cartesia optional — enable ENABLE_CARTESIA after benchmark)
VOICE_PREMIUM_STT_PROVIDER=sarvam
VOICE_PREMIUM_STT_MODEL=saaras:v3-realtime
VOICE_PREMIUM_LLM_PROVIDER=openai
VOICE_PREMIUM_LLM_MODEL=gpt-realtime-2.1-mini
VOICE_PREMIUM_TTS_PROVIDER=sarvam
VOICE_PREMIUM_TTS_MODEL=bulbul:v3

# --- Phase 5: Production platform ---
SESSION_SECRET=change-me-in-production
DEV_PORTAL_USERNAME=admin
DEV_PORTAL_PASSWORD=change-me-strong-password
# Keep false so tunnel/share users cannot reach /dev or /api/dev (localhost only).
DEV_PORTAL_ALLOW_REMOTE=0
# Optional: pbkdf2-sha256 hash instead of plain text (python -c "from server.auth.passwords import hash_portal_password; print(hash_portal_password('your-password'))")
# APP_CONSOLE_USERNAME=
# APP_CONSOLE_PASSWORD=
# E2E defaults (Playwright): e2e / e2e-test
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
SERVE_CLIENT_STATIC=true
# REDIS_URL=redis://localhost:6379/0
ENABLE_EXOTEL=true
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_ACCOUNT_SID=          # From Exotel dashboard → API Settings
EXOTEL_SUBDOMAIN=api.exotel.com
# EXOTEL_EXOPHONE=+91XXXXXXXXXX
# EXOTEL_WEBHOOK_BASE_URL=https://your-tunnel.example.com

# Active PSTN provider for dev Test Studio (exotel | telnyx | plivo)
# Telnyx L16 @ 16 kHz is the validated production path (tests 1–10).
TELEPHONY_PROVIDER=telnyx
ENABLE_TELNYX=true
# TELNYX_API_KEY=              # Telnyx Mission Control → API Keys
# TELNYX_PUBLIC_KEY=           # Mission Control → Keys & Credentials → Public Key (Ed25519 webhook verify)
# TELNYX_CONNECTION_ID=        # Call Control Application connection ID
# TELNYX_PHONE_NUMBER=+91XXXXXXXXXX
# TELNYX_OUTBOUND_VOICE_PROFILE_ID=   # optional — auto-discovered from Default OVP
# TELNYX_WEBHOOK_TOLERANCE_SEC=300
# TELNYX_MAX_CONCURRENT_CALLS=50
# PSTN cost estimates (Test Studio; match your Telnyx rate deck):
# TELNYX_SIP_OUTBOUND_INDIA_USD_PER_MIN=0.009
# TELNYX_ESTIMATE_CALL_RECORDING=true
ENABLE_PLIVO=false
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_PHONE_NUMBER=+91XXXXXXXXXX
CAMPAIGN_MAX_CONCURRENCY=5
RECORDING_CONSENT_REQUIRED=false

# --- Production canary (TEST 9) ---
# CANARY_ENABLED=false
# CANARY_MAX_CALLS_PER_DAY=20
# CANARY_ALLOWED_DESTINATIONS=+918897908470,+13526146416
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Next.js web (web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# ---- Wallet, pricing and payment walls ----
# Monthly rental for a bought phone number: $4.00
DID_MONTHLY_USD_CENTS=400
DID_MONTHLY_INR_PAISE=50000
# Wallet top-up bounds. $3 is the smallest payment a workspace can make.
TOPUP_MIN_USD=3
TOPUP_MAX_USD=500
# Refuse to answer inbound calls while the wallet is below the minimum balance.
# Fail-open: a lookup error still answers the call, so a fault never drops a caller.
PSTN_ENFORCE_WALLET_ON_INBOUND=true
PSTN_MIN_BALANCE_USD_CENTS=50
PSTN_MIN_BALANCE_INR_PAISE=5000
PSTN_RATE_USD_CENTS_PER_MIN=9
PSTN_RATE_INR_PAISE_PER_MIN=900
WEB_AGENT_RATE_USD_CENTS_PER_MIN=7
WEB_AGENT_RATE_INR_PAISE_PER_MIN=700

# ---- Didit KYC (gov ID OCR + liveness + face match) ----
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=
# DIDIT_CALLBACK_URL=https://app-dev.yourdomain.com/
# KYC_GATE_PURCHASES=true
# ---- Subscriber auth: sessions & transactional email ----
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Server-side sliding window. A refresh older than the idle bound is refused even
# though its token is still inside JWT_REFRESH_TTL_DAYS, and one sign-in is capped
# at the absolute bound regardless of activity. Set either to 0 to disable.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_MAX_HOURS=24
# Transactional email (verification, password reset) goes through Resend. The sender
# domain must be verified at https://resend.com/domains or every send fails 403 and
# /api/health reports email.deliverable=false.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@example.com
# Development only: return the reset link from /api/auth/forgot-password so the flow
# can be driven without a working mail provider. Never enable in production.
AUTH_DEBUG_EXPOSE_RESET_TOKEN=false

# ---- Cloudflare Integration ----
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# ---- Cloudflare R2 Object Storage (Zero Egress Call Archives) ----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=voxly-call-archives

# ---- Nango Multi-Tenant Unified Integrations & Voice Tools ----
# NANGO_API_KEY=
# NANGO_SECRET_KEY=
# NANGO_ENVIRONMENT_UUID=
# NANGO_BASE_URL=https://api.nango.dev
# COMPOSIO_API_KEY=