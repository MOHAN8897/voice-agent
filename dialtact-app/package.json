{
  "name": "dialtact-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "vite",
    "start": "vite preview --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "check:copy": "node scripts/check-landing-copy.mjs",
    "test:rig": "node --test scripts/bot-rig.test.mjs && node scripts/check-hand-clearance.mjs",
    "test:editor-variables": "node --test scripts/editor-variables.test.mjs",
    "test:google-identity": "node --test scripts/google-identity.test.mjs",
    "test:reticle": "node --test scripts/reticle-gate.test.mjs",
    "test:reticle:production": "node scripts/check-reticle-production.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:admin-transcription": "playwright test --config=e2e/admin-transcription.config.js",
    "test:e2e:ui": "playwright test --ui",
    "test:stagehand": "node scripts/stagehand-smoke.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@nangohq/frontend": "^0.71.12",
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.14",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "driver.js": "^1.9.0",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.475.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^2.4.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@reticlehq/react": "^3.7.0",
    "@reticlehq/vite-plugin": "^3.7.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  },
  "overrides": {
    "jsondiffpatch": "^0.7.6"
  }
}
